# Cấu hình Deploy Test / Production - Shop NRO Thanh Dung
HOST=127.0.0.1
PORT=3000

# Tài khoản quản trị đăng bán acc & theo dõi bảo mật (nên đổi mật khẩu mạnh khi deploy)
ADMIN_USER=thanhdung
ADMIN_PASS=ThanhDung@NRO2026!

# Khóa ký nội bộ (nếu bỏ trống hệ thống tự sinh ổn định trong data/.hmac-key)
APP_SECRET=

# Đặt thành 1 khi chạy sau Reverse Proxy có HTTPS (Nginx / Cloudflare / Railway / Render)
TRUST_PROXY=0
FORCE_SECURE_COOKIE=0

# Tùy chọn đường dẫn lưu trữ cố định khi mount Volume trên VPS / Cloud PaaS
DATA_DIR=
UPLOADS_DIR=
